$ PROGRAM INFORMATION
  PROGRAM  "ETABS"  VERSION "21.0.0"

$ CONTROLS
  UNITS  "KN"  "M"  "C"

$ STORIES - IN SEQUENCE FROM TOP
  STORY "Story2"  HEIGHT 3  MASTERSTORY "Yes"
  STORY "Story1"  HEIGHT 3  SIMILARTO "Story2"
  STORY "Base"  ELEV 0

$ MATERIAL PROPERTIES
  MATERIAL  "C30"  TYPE "Concrete"  WEIGHTPERVOLUME 25

$ FRAME SECTIONS
  FRAMESECTION  "C50X50"  MATERIAL "C30"  SHAPE "Concrete Rectangular"  D 0.5  B 0.5
  FRAMESECTION  "B30X60"  MATERIAL "C30"  SHAPE "Concrete Rectangular"  D 0.6  B 0.3

$ SHELL PROPERTIES
  SHELLPROP  "Slab200"  PROPTYPE  "Slab"  MATERIAL "C30"  MODELINGTYPE "ShellThin"  SLABTYPE "Slab"  SLABTHICKNESS 0.2
  SHELLPROP  "Wall250"  PROPTYPE  "Wall"  MATERIAL "C30"  MODELINGTYPE "ShellThin"  WALLTHICKNESS 0.25

$ POINT COORDINATES
  POINT "1"  0 0
  POINT "2"  6 0
  POINT "3"  6 5
  POINT "4"  0 5

$ LINE CONNECTIVITIES
  LINE  "C1"  COLUMN  "1"  "1"  1
  LINE  "C2"  COLUMN  "2"  "2"  1
  LINE  "C3"  COLUMN  "3"  "3"  1
  LINE  "C4"  COLUMN  "4"  "4"  1
  LINE  "B1"  BEAM  "1"  "2"  0
  LINE  "B2"  BEAM  "2"  "3"  0
  LINE  "B3"  BEAM  "3"  "4"  0
  LINE  "B4"  BEAM  "4"  "1"  0

$ AREA CONNECTIVITIES
  AREA "F1"  FLOOR  4  "1"  "2"  "3"  "4"  0  0  0  0
  AREA "W1"  PANEL  4  "1"  "2"  "2"  "1"  0  0  1  1

$ LINE ASSIGNS
  LINEASSIGN  "C1"  "Story2"  SECTION "C50X50"  MINNUMSTA 3
  LINEASSIGN  "C2"  "Story2"  SECTION "C50X50"  MINNUMSTA 3
  LINEASSIGN  "C3"  "Story2"  SECTION "C50X50"  MINNUMSTA 3
  LINEASSIGN  "C4"  "Story2"  SECTION "C50X50"  MINNUMSTA 3
  LINEASSIGN  "B1"  "Story2"  SECTION "B30X60"  MINNUMSTA 3
  LINEASSIGN  "B2"  "Story2"  SECTION "B30X60"  MINNUMSTA 3
  LINEASSIGN  "B3"  "Story2"  SECTION "B30X60"  MINNUMSTA 3
  LINEASSIGN  "B4"  "Story2"  SECTION "B30X60"  MINNUMSTA 3
  LINEASSIGN  "C1"  "Story1"  SECTION "C50X50"  MINNUMSTA 3
  LINEASSIGN  "C2"  "Story1"  SECTION "C50X50"  MINNUMSTA 3
  LINEASSIGN  "C3"  "Story1"  SECTION "C50X50"  MINNUMSTA 3
  LINEASSIGN  "C4"  "Story1"  SECTION "C50X50"  MINNUMSTA 3
  LINEASSIGN  "B1"  "Story1"  SECTION "B30X60"  MINNUMSTA 3
  LINEASSIGN  "B2"  "Story1"  SECTION "B30X60"  MINNUMSTA 3
  LINEASSIGN  "B3"  "Story1"  SECTION "B30X60"  MINNUMSTA 3
  LINEASSIGN  "B4"  "Story1"  SECTION "B30X60"  MINNUMSTA 3

$ AREA ASSIGNS
  AREAASSIGN  "F1"  "Story2"  SECTION "Slab200"  DIAPHRAGM "D1"
  AREAASSIGN  "W1"  "Story2"  SECTION "Wall250"  PIER "P1"
  AREAASSIGN  "F1"  "Story1"  SECTION "Slab200"  DIAPHRAGM "D1"
  AREAASSIGN  "W1"  "Story1"  SECTION "Wall250"  PIER "P1"

  END
